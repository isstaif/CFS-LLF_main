[Unit]
Description=Description of your script
After=network.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/local/scratch/CFS-LLF_main
ExecStart=/usr/bin/python3 scripts/backend.py --ip_address 127.0.0.1
Restart=always
